{
    "build_script": "../certora_build.py",
    "optimistic_loop": true,
    "precise_bitwise_ops": true,
    "process": "emv",
    "rule": [
        "add_shares_increases_user_shares",
        "queue_shares_for_withdrawal_correct",
        "queue_shares_balance_error_fails",
        "queue_shares_too_many_q4w_fails",
        "withdraw_shares_length",
        "withdraw_shares_last_queued_after_first",
        "withdraw_shares_balance_error_fails",
        "withdraw_shares_not_expired_fails",
        "dequeue_more_than_queue_fails",
        "dequeue_shares_balance_error_fails",
        "dequeue_shares_length",
        "dequeue_shares_last_queued_after_first"
    ]
}